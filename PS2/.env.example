# LTA DataMall API Key (Free registration at https://datamall.lta.gov.sg)
# Note: The app includes built-in realistic simulation scenarios so an API key
# is completely optional to evaluate Rachel's journey and disruption responses!
LTA_DATAMALL_KEY=

# OneMap API Token (Optional, for live dynamic public transit & road routing)
# Register at https://www.onemap.gov.sg/apidocs/
ONEMAP_TOKEN=

# Server Port (defaults to 5000)
PORT=5000


